{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sztu-connect:schema:event:0.1.0",
  "title": "Digital SZTU event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "status",
    "time",
    "summary",
    "claims",
    "links",
    "privacy",
    "provenance",
    "narrative"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^event-[a-z0-9][a-z0-9-]*$",
      "maxLength": 240
    },
    "type": {
      "const": "event"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "uniqueItems": true,
      "default": []
    },
    "status": {
      "enum": [
        "draft",
        "source-backed",
        "corroborated",
        "contested",
        "withdrawn"
      ]
    },
    "time": {
      "$ref": "urn:digital-sztu:schema:record-common:0.2.0#/$defs/time"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:digital-sztu:schema:record-common:0.2.0#/$defs/claim"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "urn:digital-sztu:schema:record-common:0.2.0#/$defs/link"
      },
      "default": []
    },
    "privacy": {
      "$ref": "urn:digital-sztu:schema:record-common:0.2.0#/$defs/privacy"
    },
    "provenance": {
      "$ref": "urn:digital-sztu:schema:record-common:0.2.0#/$defs/provenance"
    },
    "narrative": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[^/\\\\]+\\.md$"
    }
  }
}
