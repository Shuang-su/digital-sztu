{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sztu-connect:schema:knowledge-chunk:0.1.0",
  "title": "Digital SZTU provider-neutral knowledge chunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chunk_id",
    "revision_id",
    "owner_id",
    "owner_type",
    "chunk_kind",
    "evidence_role",
    "locator",
    "title",
    "text",
    "language",
    "time",
    "history_forms",
    "claim_ids",
    "citations",
    "links",
    "verification",
    "source_metadata",
    "privacy",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ]
    },
    "chunk_id": {
      "type": "string",
      "pattern": "^urn:(sztu-connect|digital-sztu):chunk:[a-z0-9][a-z0-9:-]*$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "owner_id": {
      "type": "string",
      "pattern": "^(event|knowledge|person|org|place|institution|topic|collection|source)-[a-z0-9][a-z0-9-]*$"
    },
    "owner_type": {
      "enum": [
        "event",
        "node",
        "collection",
        "source",
        "knowledge"
      ]
    },
    "chunk_kind": {
      "enum": [
        "summary",
        "claim",
        "node-metadata",
        "source-metadata"
      ]
    },
    "evidence_role": {
      "enum": [
        "claim-evidence",
        "navigation",
        "directory-metadata",
        "source-metadata"
      ]
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "time": {
      "type": [
        "object",
        "null"
      ]
    },
    "history_forms": {
      "type": "array",
      "items": {
        "enum": [
          "annals",
          "biographical",
          "institutional",
          "thematic"
        ]
      },
      "uniqueItems": true
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^claim-[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "role"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^source-[a-z0-9][a-z0-9-]*$"
          },
          "role": {
            "enum": [
              "supports",
              "contradicts",
              "context"
            ]
          },
          "locator": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "direction",
          "relation",
          "other_id",
          "claim_ids",
          "source_ids",
          "locator"
        ],
        "properties": {
          "direction": {
            "enum": [
              "outgoing",
              "incoming"
            ]
          },
          "relation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "other_id": {
            "type": "string",
            "pattern": "^(event|knowledge|person|org|place|institution|topic|collection|source)-[a-z0-9][a-z0-9-]*$"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^claim-[a-z0-9][a-z0-9-]*$"
            },
            "uniqueItems": true
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^source-[a-z0-9][a-z0-9-]*$"
            },
            "uniqueItems": true
          },
          "locator": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_status",
        "claim"
      ],
      "properties": {
        "record_status": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "claim": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "certainty"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "fact",
                    "memory",
                    "allegation",
                    "interpretation",
                    "uncertain"
                  ]
                },
                "certainty": {
                  "enum": [
                    "high",
                    "medium",
                    "low",
                    "unknown"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "source_metadata": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_kind",
            "creator",
            "publisher",
            "locator",
            "dates",
            "hashes",
            "access",
            "rights",
            "reliability"
          ],
          "properties": {
            "source_kind": {
              "type": "string"
            },
            "creator": {
              "type": [
                "string",
                "null"
              ]
            },
            "publisher": {
              "type": [
                "string",
                "null"
              ]
            },
            "locator": {
              "type": "object"
            },
            "dates": {
              "type": "object"
            },
            "hashes": {
              "type": "array"
            },
            "access": {
              "enum": [
                "public",
                "metadata-only"
              ]
            },
            "rights": {
              "type": "object"
            },
            "reliability": {
              "type": "object"
            }
          }
        }
      ]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk",
        "handling",
        "indexing"
      ],
      "properties": {
        "risk": {
          "enum": [
            "none",
            "ordinary-personal",
            "sensitive",
            "prohibited"
          ]
        },
        "handling": {
          "enum": [
            "as-recorded",
            "minimized",
            "redacted",
            "metadata-only",
            "restricted"
          ]
        },
        "indexing": {
          "enum": [
            "include",
            "exclude"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_path",
        "record_sha256",
        "exporter",
        "exporter_version",
        "chunking_profile"
      ],
      "properties": {
        "record_path": {
          "type": "string",
          "pattern": "^(content|sources)/"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "exporter": {
          "enum": [
            "sztu-connect",
            "digital-sztu"
          ]
        },
        "exporter_version": {
          "enum": [
            "0.1.0",
            "0.2.0"
          ]
        },
        "chunking_profile": {
          "const": "structured-fields-v1"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "chunk_kind": {
            "const": "claim"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_role": {
            "const": "claim-evidence"
          },
          "verification": {
            "properties": {
              "claim": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "owner_type": {
            "const": "source"
          }
        }
      },
      "then": {
        "properties": {
          "source_metadata": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "source_metadata": {
            "type": "null"
          }
        }
      }
    }
  ]
}
