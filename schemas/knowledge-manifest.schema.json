{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sztu-connect:schema:knowledge-manifest:0.1.0",
  "title": "Digital SZTU knowledge export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "chunking_profile",
    "chunks_path",
    "chunk_count",
    "chunks_sha256",
    "dataset_revision",
    "embedding"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ]
    },
    "format": {
      "enum": [
        "sztu-connect-knowledge-jsonl@0.1",
        "digital-sztu-knowledge-jsonl@0.2"
      ]
    },
    "chunking_profile": {
      "const": "structured-fields-v1"
    },
    "chunks_path": {
      "const": "chunks.jsonl"
    },
    "chunk_count": {
      "type": "integer",
      "minimum": 0
    },
    "chunks_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dataset_revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "embedding": {
      "type": "null"
    }
  }
}
